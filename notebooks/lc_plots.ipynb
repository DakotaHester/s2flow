    "    steps = path_parts[3].split('_')[-1]\n",
    "    model = path_parts[4]\n",
    "    fold = path_parts[5].split('_')[-1]\n",
    "    \n",
    "    df = pd.read_csv(csv_file)\n",
    "    df['steps'] = int(steps)\n",
    "    df['model'] = model\n",
    "    df['fold'] = fold\n",
    "    dfs.append(df)\n",
    "\n",
    "steps_metrics_df = pd.concat(dfs, ignore_index=True)\n"
