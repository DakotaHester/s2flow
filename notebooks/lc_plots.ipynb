   "source": [
    "lc_metrics_dfs = []\n",
    "for csv in glob('../runs/s2flow_lc_sampling_steps_sweep/*/*/*/*/*/lc_summary_metrics.csv'):\n",
    "    csv = Path(csv)\n",
    "    csv_pars = csv.parts\n",
    "    # for i, part in enumerate(csv_pars):\n",
    "    #     print(f\"Part {i}: {part}\")\n",
    "    # break\n",
    "    sampler = csv_pars[3]\n",
    "    steps = int(csv_pars[4].split('_')[1])\n",
    "    model = csv_pars[5]\n",
    "    fold = csv_pars[6].split('_')[1]\n",
    "    lc_metrics_df = pd.read_csv(csv)\n",
    "    lc_metrics_df['sampler'] = sampler\n",
    "    lc_metrics_df['steps'] = steps\n",
    "    lc_metrics_df['model'] = model\n",
    "    lc_metrics_df['fold'] = fold\n",
    "    lc_metrics_dfs.append(lc_metrics_df)\n",
    "\n",
    "lc_metrics_df = pd.concat(lc_metrics_dfs, ignore_index=True)\n",
    "lc_metrics_df.loc[lc_metrics_df['sampler'] == 'euler'].sort_values(by='macro_f1', ascending=False).head(20)"
   ]
  },
