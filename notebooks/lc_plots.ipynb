    "# histogram match Sentinel-2 to NAIP for better visualization\n",
    "\n",
    "def histogram_match(s2_fullres, naip, s2_img_downres):\n",
    "    \n",
    "    # transform s2 from 0-10000 to 0-255\n",
    "    s2 = (s2_fullres / 10000 * 255).astype(np.uint8)\n",
    "    s2_hist = np.histogram(s2.flatten().astype(np.int16), bins=256, range=(0, 255), density=True)\n",
    "    naip_hist = np.histogram(naip.flatten(), bins=256, range=(0, 255), density=True)\n",
    "    \n",
    "    s2_cdf = np.cumsum(s2_hist[0])\n",
    "    naip_cdf = np.cumsum(naip_hist[0])\n",
    "    \n",
    "    s2_cdf_normalized = s2_cdf / s2_cdf[-1]\n",
    "    naip_cdf_normalized = naip_cdf / naip_cdf[-1]\n",
    "    \n",
    "    mapping = np.zeros(256, dtype=np.uint8)\n",
    "    for i in range(256):\n",
    "        diff = np.abs(s2_cdf_normalized[i] - naip_cdf_normalized)\n",
    "        mapping[i] = np.argmin(diff)\n",
    "    \n",
    "    s2_downres = (s2_img_downres / 10000 * 255).astype(np.uint8)\n",
    "    s2_matched = mapping[s2_downres]\n",
    "    return s2_matched\n",
    "\n",
    "\n",
    "def harmonize(s2_fullres, naip, s2_img_downres):\n",
    "    # use OLS to harmonize s2 to naip on a per-band basis, then apply to downres s2 image\n",
    "    # print(s2_fullres.shape, naip.shape, s2_img_downres.shape)\n",
    "    \n",
    "    gain = []\n",
    "    bias = []\n",
    "    for band in range(3):\n",
    "        s2_band = s2_fullres[band].flatten()\n",
    "        naip_band = naip[band].flatten()\n",
    "        \n",
    "        A = np.vstack([s2_band, np.ones(len(s2_band))]).T\n",
    "        m, c = np.linalg.lstsq(A, naip_band, rcond=None)[0]\n",
    "        gain.append(m)\n",
    "        bias.append(c)\n",
    "    \n",
    "    s2_harmonized = np.zeros_like(s2_img_downres)\n",
    "    for band in range(3):\n",
    "        s2_harmonized[band] = s2_img_downres[band] * gain[band] + bias[band]\n",
    "    s2_harmonized = np.clip(s2_harmonized, 0, 255).astype(np.uint8)\n",
    "    return s2_harmonized, naip"
   ]
