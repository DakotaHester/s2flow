     "output_type": "execute_result"
    }
   ],
   "source": [
    "# find model/fold combination with highest increase in macro f1 when comparisin sampler = s2 / steps = 0 to sampler = euler / steps = 1\n",
    "diffs = []\n",
    "for model in lc_metrics_df['model'].unique():\n",
    "    model_data = lc_metrics_df[lc_metrics_df['model'] == model]\n",
    "    for fold in model_data['fold'].unique():\n",
    "        fold_data = model_data[model_data['fold'] == fold]\n",
    "        s2_0 = fold_data[(fold_data['sampler'] == 's2') & (fold_data['steps'] == 0)]['macro_f1'].values\n",
    "        euler_1 = fold_data[(fold_data['sampler'] == 'euler') & (fold_data['steps'] == 1)]['macro_f1'].values\n",
    "        resrgan_1 = fold_data[(fold_data['sampler'] == 'realesrgan') & (fold_data['steps'] == 1)]['macro_f1'].values\n",
    "        if len(s2_0) > 0 and len(euler_1) > 0 and len(resrgan_1) > 0:\n",
    "            diff_s2 = euler_1[0] - s2_0[0]\n",
    "            diff_resrgan = euler_1[0] - resrgan_1[0]\n",
    "            diffs.append({\n",
    "                'model': model,\n",
    "                'fold': fold,\n",
    "                'f1_diff_s2': diff_s2,\n",
    "                'f1_diff_resrgan': diff_resrgan\n",
    "            })\n",
    "diffs_df = pd.DataFrame(diffs)\n",
    "diffs_df.sort_values(by='f1_diff_s2', ascending=False).head(10)"
   ]
  },
